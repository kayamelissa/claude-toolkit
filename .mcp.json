{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest", "--no-usage-statistics"]
    },
    "perplexity": {
      "command": "npx",
      "args": ["-yq", "@perplexity-ai/mcp-server"],
      "env": { "PERPLEXITY_API_KEY": "${PERPLEXITY_API_KEY}" }
    },
    "firecrawl": {
      "command": "npx",
      "args": ["-y", "firecrawl-mcp"],
      "env": { "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}" }
    },
    "geo-optimizer": {
      "command": "uvx",
      "args": ["--from", "geo-optimizer-skill[mcp]", "geo-mcp"]
    },
    "gsc": {
      "command": "uvx",
      "args": ["mcp-search-console"],
      "env": { "GSC_CREDENTIALS_PATH": "${GSC_CREDENTIALS_PATH}", "GSC_SKIP_OAUTH": "true" }
    }
  }
}
